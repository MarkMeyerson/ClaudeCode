# --- IT4Causes tenant (required) ---
# Directory (tenant) ID of the IT4Causes Entra tenant
IT4C_TENANT_ID=00000000-0000-0000-0000-000000000000
# Application (client) ID of the single-tenant app registration (see SETUP.md, Path A)
IT4C_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- Auth mode ---
# "delegated" (default): device-code sign-in as Mark, read-only delegated scopes.
# "app": client-credentials (app-only) — only if the GA ever grants application permissions.
IT4C_AUTH_MODE=delegated
# Only needed for IT4C_AUTH_MODE=app
IT4C_CLIENT_SECRET=

# Where the MSAL token cache (refresh token) is persisted. Keep this file private.
IT4C_TOKEN_CACHE=.it4c-token-cache.json

# Timezone used for calendar views and the daily briefing
IT4C_TIMEZONE=America/New_York

# --- Trello (optional; tools are only registered when both are set) ---
# NOTE: the old custom Trello MCP was decommissioned 2026-06-20 and is not being
# revived. These are optional additive tools inside this bridge, off by default.
TRELLO_KEY=
TRELLO_TOKEN=
